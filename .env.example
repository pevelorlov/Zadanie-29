# День 27: локальная модель по умолчанию. API-ключ LM Studio обычно не требуется.
APP_DEFAULT_MODEL=ornith-1.5-9b
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=ornith-1.5-9b
LM_STUDIO_TIMEOUT=1800

# Голосовая модель выключена при запуске и включается галочкой в интерфейсе.
WHISPER_AUTOSTART=false

# Необязательно: только если в интерфейсе выбираются облачные модели DeepSeek.
DEEPSEEK_API_KEY=вставьте_сюда_свой_ключ
# Необязательно, только для отдельного OpenAQ MCP (бесплатный ключ openaq.org).
OPENAQ_API_KEY=
# Необязательно: OpenAlex работает без ключа, ключ повышает лимиты API.
OPENALEX_API_KEY=
# Необязательно: DEBUG, INFO, WARNING или ERROR. По умолчанию INFO.
DEEPSEEK_LOG_LEVEL=INFO
